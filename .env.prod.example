# Production reuses the prototype MariaDB instance managed by the dev Compose project.
DB_USERNAME=pos21
DB_PASSWORD=replace-with-the-mariadb-application-password
JWT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-random-cron-token
MAIL_ENABLED=false
MAIL_FROM=ihcho@pentaworks.net
MAIL_FROM_NAME=펜타웍스 알림 (회신불가)
PUBLIC_BASE_URL=https://app.pentaworks.net
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL_ENABLED=false
BARO_KAKAO_ENABLED=false
BARO_CERT_KEY=
BARO_CORP_NUM=
BARO_SENDER_ID=
BARO_SMS_SENDER_NUM=

# Production containers are reachable only through local Nginx.
FRONTEND_PORT=3100
BACKEND_PORT=8180
CORS_ALLOWED_ORIGINS=https://app.pentaworks.net
NEXT_PUBLIC_API_BASE_URL=https://app.pentaworks.net/api/v1
