# Production reuses the prototype MariaDB instance managed by the dev Compose project.
DB_USERNAME=pos21
DB_PASSWORD=replace-with-the-mariadb-application-password
JWT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-random-cron-token
SLACK_WEBHOOK_URL=

# Production containers are reachable only through local Nginx.
FRONTEND_PORT=3100
BACKEND_PORT=8180
CORS_ALLOWED_ORIGINS=https://app.pentaworks.net
NEXT_PUBLIC_API_BASE_URL=https://app.pentaworks.net/api/v1
