# MariaDB application account
DB_USERNAME=pos21
DB_PASSWORD=replace-with-the-mariadb-application-password
MARIADB_ROOT_PASSWORD=replace-with-the-mariadb-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION_MINUTES=43200
JWT_REFRESH_EXPIRATION_DAYS=365
JWT_SECURE_COOKIE=false
CRON_SECRET=replace-with-a-random-cron-token

# Account invitation and password reset email (disabled until SMTP is configured)
MAIL_ENABLED=false
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=펜타웍스 알림 (회신불가)
PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL_ENABLED=false
BARO_KAKAO_ENABLED=false
BARO_KAKAO_DEEP_LINK_ENABLED=false
BARO_CERT_KEY=
BARO_CORP_NUM=
BARO_SENDER_ID=
BARO_SMS_SENDER_NUM=

# Development ports exposed directly by the server.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://192.168.0.210:3000

# This value is embedded into the frontend browser bundle during its Docker build.
NEXT_PUBLIC_API_BASE_URL=http://192.168.0.210:8080/api/v1

# MREyes backend -> Office backend read-only integration
OFFICE_BASE_URL=http://office-backend:8080
OFFICE_API_KEY=replace-with-the-same-long-random-service-api-key
